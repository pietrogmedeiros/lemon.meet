# Copie este arquivo para .env e preencha os valores
# No Railway, configure cada variável no painel Variables

PORT=3000

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-key

# Groq (transcrição de áudio)
GROQ_API_KEY=sua-chave-groq

# URL do frontend (Firebase Hosting)
FRONTEND_URL=https://lemon-meet.web.app

# AbacatePay (pagamentos)
# API key em: https://app.abacatepay.com (Configurações → API)
ABACATEPAY_API_KEY=abc_prod_...
# Secret usado para validar HMAC-SHA256 dos webhooks (definido ao cadastrar o webhook)
ABACATEPAY_WEBHOOK_SECRET=
# Product IDs das assinaturas mensais cadastradas no painel
ABACATEPAY_PRODUCT_ID_STARTER=prod_...
ABACATEPAY_PRODUCT_ID_PROFESSIONAL=prod_...

# Painel /admin/metrics — token compartilhado entre devs autorizados.
# Mínimo 16 chars. Gere com: openssl rand -hex 24
ADMIN_METRICS_KEY=
