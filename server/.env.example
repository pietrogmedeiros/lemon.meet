# Copie este arquivo para .env e preencha os valores
# No Railway, configure cada variável no painel Variables

PORT=3000

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua-service-key

# Groq (transcrição de áudio)
GROQ_API_KEY=sua-chave-groq

# URL do frontend (Firebase Hosting)
FRONTEND_URL=https://lemon-meet.web.app

# AbacatePay (pagamentos)
# API key em: https://app.abacatepay.com (Configurações → API)
ABACATEPAY_API_KEY=abc_prod_...
# Secret usado para validar HMAC-SHA256 dos webhooks (definido ao cadastrar o webhook)
ABACATEPAY_WEBHOOK_SECRET=
# Product IDs das assinaturas mensais cadastradas no painel
ABACATEPAY_PRODUCT_ID_STARTER=prod_...
ABACATEPAY_PRODUCT_ID_PROFESSIONAL=prod_...

# Painel /admin/metrics — token compartilhado entre devs autorizados.
# Mínimo 16 chars. Gere com: openssl rand -hex 24
ADMIN_METRICS_KEY=

# URL pública deste backend — usada para montar os callbacks de webhook
# (MeetingBaas e Attendee). Sem isso, os providers não conseguem notificar.
SERVER_URL=https://vibe-aiserver-production.up.railway.app

# ── Bots híbridos (MeetingBaas + Attendee) ──────────────────────────────
# Attendee é o provider self-hosted (Railway). Com ATTENDEE_ENABLED!='true'
# o sistema roda 100% MeetingBaas (comportamento atual, sem mudanças).
ATTENDEE_ENABLED=false
# URL do serviço Attendee na Railway (ex: https://attendee-production.up.railway.app)
ATTENDEE_API_URL=
# API key do projeto Attendee (header "Authorization: Token <key>")
ATTENDEE_API_KEY=
# Secret do webhook do Attendee — valida HMAC-SHA256 (X-Webhook-Signature).
# É uma string BASE64; o backend decodifica para obter a chave HMAC.
ATTENDEE_WEBHOOK_SECRET=
# % de joins imediatos roteados para o Attendee (0-100). Comece baixo (ex: 10).
ATTENDEE_TRAFFIC_PERCENT=10
# Teto de bots simultâneos no Attendee — DEVE bater com --concurrency do worker.
# Plano Hobby da Railway comporta ~3.
ATTENDEE_MAX_CONCURRENT=3
# Idioma do Deepgram no Attendee (testado: 'pt-BR' com model nova-3)
ATTENDEE_DEEPGRAM_LANGUAGE=pt-BR

# ── Skribby (provider gerenciado — Fase 0 DARK) ─────────────────────────
# Candidato a substituir/complementar o MeetingBaas. Com SKRIBBY_ENABLED!='true'
# o sistema roda 100% MeetingBaas (comportamento atual, sem mudanças). O provider
# nem é instanciado e o webhook /api/skribby/webhook é inerte. Ligar só na Fase 1
# (canary), gated pelo piloto A/B autenticado.
SKRIBBY_ENABLED=false
# URL base da REST API do Skribby (docs.skribby.io/rest-api/openapi)
SKRIBBY_API_URL=
# API key do Skribby (header de auth — a confirmar no piloto)
SKRIBBY_API_KEY=
# Secret do webhook do Skribby — valida HMAC-SHA256 hex (header x-skribby-signature:
# sha256=<hex>; provável payload assinado `timestamp.body` estilo Stripe, a confirmar).
# O webhook só emite 'status_update'; o transcript é buscado via GET /api/v1/bot/{id}
# quando new_status='finished'. Modelo default não diariza (speaker=null).
SKRIBBY_WEBHOOK_SECRET=
# % de joins roteados para o Skribby (0-100). Fase 1 começa baixo (ex: 5-10).
SKRIBBY_ROLLOUT_PERCENT=0
# Idioma da transcrição no Skribby
SKRIBBY_LANGUAGE=pt-BR
# Conta autenticada do Skribby (Authenticated Accounts). SEM ISSO o bot entra
# como guest anônimo e o Google Meet BARRA (not_admitted) — era a causa dos ~69%
# de falha de join. OBRIGATÓRIO em produção para o bot ser admitido.
SKRIBBY_ACCOUNT_ID=

# ── Alerta operacional por e-mail ────────────────────────────
# Avisa o admin quando os bots param (conta do Skribby recusada pelo Google).
# Sem RESEND_API_KEY o envio é ignorado e só o alerta in-app funciona.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Opcional. O padrão onboarding@resend.dev só entrega para o e-mail dono da
# conta Resend; para outros destinatários, use domínio verificado.
ALERT_EMAIL_FROM=

# Force o bot a fazer login no Google já na entrada, em vez de tentar como
# convidado primeiro. Deixe VAZIO/false: com true, um bloqueio de login do
# Google derruba 100% das capturas de uma vez, inclusive as salas abertas.
SKRIBBY_ALWAYS_AUTHENTICATE=
